POSTGRES_DB=shopify_db
POSTGRES_USER=shopify_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

# Dentro de Docker la base escucha en 5432 (5433 es solo el puerto de tu PC)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/shopify_db
SPRING_DATASOURCE_USERNAME=shopify_user
SPRING_DATASOURCE_PASSWORD=changeme
SERVER_PORT=8080

# Mínimo 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION=86400000

CORS_ORIGENES=http://localhost:5173,http://localhost:5174

VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_PORT=5174

# Mercado Pago (Checkout Pro, modo de prueba). Access Token de prueba de "Tus integraciones".
# NO subas el valor real al repositorio.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
# A esta dirección vuelve el cliente después de pagar
FRONTEND_URL=http://localhost:5173

# PayPal (Sandbox, modo de prueba). Client ID y Secret de developer.paypal.com > Apps & Credentials > Sandbox.
# Si están, el pago se hace con PayPal (en USD). NO subas los valores reales al repositorio.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
