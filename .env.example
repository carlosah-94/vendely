POSTGRES_DB=shopify_db
POSTGRES_USER=shopify_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

# Dentro de Docker la base escucha en 5432 (5433 es solo el puerto de tu PC)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/shopify_db
SPRING_DATASOURCE_USERNAME=shopify_user
SPRING_DATASOURCE_PASSWORD=changeme
SERVER_PORT=8080

# Mínimo 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRATION=86400000

CORS_ORIGENES=http://localhost:5173,http://localhost:5174

# Fotos de los productos (cloudinary.com > Dashboard > API Environment variable).
# Formato: cloudinary://clave:secreto@nombre-de-la-nube
# Sin esto, subir fotos responde 503 y se pueden seguir pegando enlaces.
CLOUDINARY_URL=

# Correos con Brevo (brevo.com): llegan a cualquier persona sin dominio propio. Si estan las dos,
# se usa Brevo en vez de Resend. Clave: SMTP & API > API Keys. Remitente: un correo tuyo que
# verificaste en Senders. Gratis hasta 300 correos al dia.
BREVO_API_KEY=
BREVO_REMITENTE_CORREO=
BREVO_REMITENTE_NOMBRE=Vendely

# Correos (resend.com > API Keys). Sin esta clave los correos se registran como "simulado"
# y no se envia nada: sirve para desarrollar sin crear la cuenta.
RESEND_API_KEY=
# Remitente de los correos. El de por defecto es el de pruebas de Resend.
RESEND_REMITENTE=Vendely <onboarding@resend.dev>
# Codigo de 6 digitos al correo antes de crear la cuenta (dueno y cliente). Sin BREVO_API_KEY ni RESEND_API_KEY el
# codigo aparece en el log del backend (docker compose logs backend). false: sin codigo
# (solo para la coleccion de Postman, que no puede leer el correo).
VERIFICAR_CORREO=true

# Carpetas de migraciones de Flyway. Asi, en desarrollo, se crean los usuarios de
# prueba. En el servidor (Render) se deja solo: classpath:db/migration
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/migration-local

VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_PORT=5174

# Mercado Pago (Checkout Pro, modo de prueba). Access Token de prueba de "Tus integraciones".
# NO subas el valor real al repositorio.
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxx
# Clave de la firma de los avisos de pago: panel de Mercado Pago > Webhooks.
# Sin ella el endpoint del webhook responde 503 (el pago por el navegador sigue funcionando).
MERCADOPAGO_WEBHOOK_SECRET=
# A esta dirección vuelve el cliente después de pagar
FRONTEND_URL=http://localhost:5173

# PayPal (Sandbox, modo de prueba). Client ID y Secret de developer.paypal.com > Apps & Credentials > Sandbox.
# Si están, el pago se hace con PayPal (en USD). NO subas los valores reales al repositorio.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id del webhook de PayPal (Apps & Credentials > tu app > Webhooks). Sin él, su endpoint da 503.
PAYPAL_WEBHOOK_ID=
