                "exec": [
                  "pm.test('Responde 200 o 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión (cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Con subdominio = cliente de esa tienda.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"maria@mail.pe\",\n  \"contrasena\": \"Clave1234\",\n  \"subdominio\": \"zapatillas-carlos\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 o 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi cuenta",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/yo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "yo"
              ]
            },
            "description": "Devuelve quién inició sesión según el token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar contraseña",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/cambiar-contrasena",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "cambiar-contrasena"
              ]
            },
            "description": "Devuelve un token nuevo; los anteriores dejan de servir.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contrasenaActual\": \"Clave1234\",\n  \"contrasenaNueva\": \"Nueva5678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 o 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); }"
                ]
              }
            }
          ]
        }
      ]
    },
