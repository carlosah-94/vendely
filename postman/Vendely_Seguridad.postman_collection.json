{
  "info": {
    "name": "Vendely · Seguridad (JWT)",
    "description": "Registro, inicio de sesión y token JWT de Vendely. Ejecuta las peticiones en orden: el token se guarda solo en la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Registro e inicio de sesión",
      "item": [
        {
          "name": "Registrar dueño de tienda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro/dueno",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro",
                "dueno"
              ]
            },
            "description": "Crea la cuenta del panel (rol ADMIN_TIENDA) y sus datos de propietario. Devuelve el token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"carlos\",\n  \"correo\": \"carlos@mail.pe\",\n  \"contrasena\": \"Clave1234\",\n  \"nombres\": \"Carlos\",\n  \"apellidoPat\": \"Ramos\",\n  \"apellidoMat\": \"Soto\",\n  \"tipoDocumento\": 2,\n  \"numeroDocumento\": \"20123456789\",\n  \"razonSocial\": \"Zapatillas Carlos S.A.C.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 o 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión (panel)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Sin subdominio = cuenta del panel.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"carlos@mail.pe\",\n  \"contrasena\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 o 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); }"
                ]
              }
            }
          ]
        },
