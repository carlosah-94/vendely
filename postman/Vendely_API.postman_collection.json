              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Celulares Carlos Perú\",\n  \"descripcion\": \"Ahora también tablets\",\n  \"correoContacto\": \"ventas@celulares.pe\",\n  \"colorPrincipal\": \"#047857\",\n  \"permiteInvitados\": false\n}",
