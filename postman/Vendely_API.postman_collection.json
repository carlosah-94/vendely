                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear tienda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/panel/tiendas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "panel",
                "tiendas"
              ]
            },
            "description": "Crea una tienda del dueño. El id queda en {{idTienda}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Celulares Carlos\",\n  \"subdominio\": \"{{subdominioNuevo}}\",\n  \"descripcion\": \"Celulares y accesorios con envío a todo el Perú\",\n  \"correoContacto\": \"ventas@celulares.pe\",\n  \"logoUrl\": \"https://placehold.co/200x200/png\",\n  \"colorPrincipal\": \"#1D4ED8\",\n  \"permiteInvitados\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Subdominio distinto en cada ejecución para poder repetir la prueba",
                  "pm.collectionVariables.set('subdominioNuevo', 'celulares-' + Date.now().toString().slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const t = pm.response.json();",
                  "pm.collectionVariables.set('idTienda', t.idTienda);",
                  "pm.test('Queda activa', () => pm.expect(t.estado).to.eql('ACTIVA'));"
                ]
              }
            }
          ]
        },
