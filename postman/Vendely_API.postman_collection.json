{
  "info": {
    "name": "Vendely · API",
    "description": "Colección de la API de Vendely. Ejecuta las carpetas en orden: 1 y 2 (seguridad), 3 y 4 (tiendas). Los tokens e ids se guardan solos en las variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Registro e inicio de sesión",
      "item": [
        {
          "name": "Registrar dueño de tienda",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro/dueno",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro",
                "dueno"
              ]
            },
            "description": "Crea la cuenta del panel (rol ADMIN_TIENDA) y sus datos de propietario. Devuelve el token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"carlos\",\n  \"correo\": \"carlos@mail.pe\",\n  \"contrasena\": \"Clave1234\",\n  \"nombres\": \"Carlos\",\n  \"primerApellido\": \"Ramos\",\n  \"segundoApellido\": \"Soto\",\n  \"tipoDocumento\": 2,\n  \"numeroDocumento\": \"20123456789\",\n  \"razonSocial\": \"Zapatillas Carlos S.A.C.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 o 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar sesión (panel)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Sin subdominio = cuenta del panel.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"carlos@mail.pe\",\n  \"contrasena\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 o 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const r = pm.response.json();",
                  "if (r.token) { pm.collectionVariables.set('token', r.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear tienda Zapatillas Carlos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/panel/tiendas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "panel",
                "tiendas"
              ]
            },
            "description": "Crea la tienda zapatillas-carlos, que usa el registro de clientes de esta carpeta. 201 si se crea; 409 si ya existía (al repetir la colección).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Zapatillas Carlos\",\n  \"subdominio\": \"zapatillas-carlos\",\n  \"correoContacto\": \"ventas@zapatillas.pe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 (creada) o 409 (ya existía)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
