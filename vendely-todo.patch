+
+    // ------------------------------------------------------------------ kit por rubro
+
+    @Test
+    void unaPasteleriaEmpiezaConSusCategoriasYSuAnuncio() throws Exception {
+        String sub = "pasteleria-" + System.nanoTime();
+        crear(sub, "comida").andExpect(status().isCreated())
