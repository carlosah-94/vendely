+        return mvc.perform(post("/api/panel/tiendas").header("Authorization", token(tienda.idDueno()))
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("{\"nombre\":\"Tienda nueva\",\"subdominio\":\"" + subdominio
+                        + "\",\"correoContacto\":\"t@prueba.pe\"" + r + "}"));
+    }
