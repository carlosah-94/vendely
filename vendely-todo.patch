+
+    @Test
+    void laBaseTambienRechazaUnNumeroMalo() {
+        org.junit.jupiter.api.Assertions.assertThrows(Exception.class, () -> jdbc.update(
+                "UPDATE tiendas SET whatsapp = '987654321' WHERE id_tienda = ?", tienda.idTienda()));
