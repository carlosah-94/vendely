+          <CampoPanel etiqueta="Gratis desde (opcional)">
+            <input value={nuevo.gratis} onChange={(e) => setNuevo((n) => ({ ...n, gratis: e.target.value }))} inputMode="decimal" placeholder="100.00" className={inputPanel()} />
